# ==========================================
# MercatoIQ - Environment Configuration
# ==========================================

# --- MongoDB Configuration ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=mercatoiq_dev_pass
MONGO_DB_NAME=mercatoiq
MONGO_PORT=27017
MONGO_URI=mongodb://admin:mercatoiq_dev_pass@localhost:27017/mercatoiq?authSource=admin

# --- NestJS Backend (/backend) ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# --- Authentication & Security ---
JWT_SECRET=change_me_in_production_super_secret_key_2026
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Python Data Pipeline (/pipeline) ---
PYTHON_BIN=python3
PIPELINE_SCRIPT_PATH=../pipeline/run_pipeline.py
PIPELINE_BACKUP_DIR=./pipeline/backup_data
PIPELINE_MIN_SEASON=2012

# --- React Frontend (/frontend) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
